generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  FORMATEUR
  ELEVE
}

model AppMeta {
  id               String   @id @default("default")
  schemaVersion    Int      @default(1)
  organizationName String   @default("")
  noteSnippets     Json     @default("[]")
  sessionTemplates Json     @default("[]")
  updatedAt        DateTime @updatedAt
}

model Student {
  id                   String   @id
  firstName            String
  lastName             String
  email                String?
  phone                String?
  company              String?
  socialSecurityNumber String?
  fundingMethod        String?
  funderName           String?
  funderSiret          String?
  funderEmail          String?
  conventionSignedAt   String?
  conventionCreatedAt  String?
  linkedConventionStudentId String?
  presenceConfirmedForSessionId String?
  documents            Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User?
}

model TrainingSession {
  id             String    @id
  title          String
  date           String
  studentIds     Json
  notes          String?
  tags           Json?
  favorited      Boolean   @default(false)
  archived       Boolean   @default(false)
  location       String?
  trainer        String?
  trainerUserId  String?
  trainerUser    User?     @relation("SessionTrainer", fields: [trainerUserId], references: [id], onDelete: SetNull)
  trainerDocuments Json?
  attestationSignatures Json?
  sessionAccounting Json?
  createdAt      DateTime?
  lastActivityAt DateTime?
  attendance     Json
  updatedAt      DateTime  @updatedAt
  signTokens     AttendanceSignToken[]
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  studentId    String?          @unique
  student      Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     AuthSession[]
  trainedSessions TrainingSession[] @relation("SessionTrainer")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Funder {
  id        String   @id @default(cuid())
  name      String
  siret     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttendanceSignToken {
  id        String          @id @default(cuid())
  token     String          @unique
  sessionId String
  studentId String
  halfDay   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime        @default(now())
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, studentId])
}
